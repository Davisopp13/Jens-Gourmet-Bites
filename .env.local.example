# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Configuration
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Contact Email (where form submissions are sent)
CONTACT_EMAIL=jensgourmetbites@gmail.com

# Site URL (update for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Receipt archive: apply supabase/migrations/20261028215008_receipt_archive.sql first.
# OpenAI is optional; originals can be archived and reviewed manually without it.
OPENAI_API_KEY=
RECEIPT_EXTRACTION_MODEL=gpt-4.1-mini
# Resend Receiving: use a dedicated subdomain so existing business MX records stay intact.
# Never put these secrets in NEXT_PUBLIC variables.
RESEND_RECEIPT_WEBHOOK_SECRET=
RECEIPT_INBOX_ADDRESS=
RECEIPT_INBOX_OWNER_ID=
# Comma-separated exact sender addresses or @domain rules, e.g. Jen's forwarding address.
RECEIPT_ALLOWED_SENDERS=

# Existing admin account UUIDs allowed to use receipt/pricing tools (comma-separated)
RECEIPT_ADMIN_USER_IDS=
